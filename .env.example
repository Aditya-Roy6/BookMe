# Database (Local Docker Postgres or Cloud Neon DB / Supabase)
# For Neon DB, uncomment and set DATABASE_URL:
# DATABASE_URL=postgresql://neondb_owner:password@ep-xyz.aws.neon.tech/neondb?sslmode=require
DB_HOST=postgres
DB_PORT=5432
DB_NAME=luminatix
DB_USER=luminatix
DB_PASSWORD=luminatix_dev
DB_TEST_NAME=luminatix_test
DB_SSL=false

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Seat Hold
SEAT_HOLD_TTL_SECONDS=600
WAITLIST_OFFER_TTL_SECONDS=900

# Email (Ethereal for dev)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@luminatix.com

# App
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# TMDB API
TMDB_ACCESS_TOKEN=
TMDB_API_KEY=
