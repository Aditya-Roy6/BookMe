# Database (Neon Serverless Postgres / Supabase / Local Docker Postgres)
DATABASE_URL=postgresql://neondb_owner:password@ep-xyz.aws.neon.tech/neondb?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bookme
DB_USER=bookme_dev
DB_PASSWORD=bookme_password
DB_SSL=false

# Redis (Upstash Serverless Redis / Local Redis)
REDIS_URL=rediss://default:token@helpful-mallard.upstash.io:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Seat Hold & Waitlist Timing (in seconds)
SEAT_HOLD_TTL_SECONDS=600
WAITLIST_OFFER_TTL_SECONDS=900

# Email Delivery (Brevo REST API or Gmail SMTP)
BREVO_API_KEY=xkeysib-your-brevo-api-key
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=BookMe <noreply@bookme.com>

# App Config
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
